---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ToolsWorkspace from "@/components/tools/ToolsWorkspace.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.toolsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb wide={true} />

  <Main pageTitle={t.pages.toolsTitle} pageDesc={t.pages.toolsDesc} wide={true}>
    <ToolsWorkspace initialTool="latex" />
  </Main>

  <Footer />
</Layout>
