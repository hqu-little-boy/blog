---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CompilerWorkspace from "@/components/compiler/CompilerWorkspace.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.compileTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb wide={true} />

  <Main
    pageTitle={t.pages.compileTitle}
    pageDesc={t.pages.compileDesc}
    wide={true}
  >
    <CompilerWorkspace />
  </Main>

  <Footer />
</Layout>
