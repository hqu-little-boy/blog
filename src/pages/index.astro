---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");

const initialFormattedDate = new Intl.DateTimeFormat(
  locale === "zh" ? "zh-CN" : "en-US",
  {
    weekday: "long",
    month: "short",
    day: "numeric",
  }
).format(new Date());
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Pixel Launcher: At a Glance Section -->
    <section id="hero" class="pt-8 pb-3">
      <div class="flex flex-col gap-2">
        <!-- Date & Status Pill -->
        <div
          class="text-on-surface-variant flex items-center gap-2.5 text-xs font-medium sm:text-sm"
        >
          <span id="pixel-at-a-glance-date" class="tracking-wide"
            >{initialFormattedDate}</span
          >
          <span class="bg-on-surface-variant/50 size-1 rounded-full"></span>
          <span
            class="bg-secondary-container text-on-secondary-container inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-semibold sm:text-xs"
          >
            <span class="bg-primary size-1.5 animate-pulse rounded-full"></span>
            <span>Material You · Pixel 风格</span>
          </span>
        </div>

        <div class="mt-1 flex items-baseline justify-between gap-4">
          <h1
            class="text-on-surface text-3xl font-bold tracking-tight sm:text-5xl"
          >
            Hi there 👋
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="text-on-surface-variant hover:bg-surface-container-high hover:text-primary inline-flex items-center justify-center rounded-full p-2.5 transition-all active:scale-95"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss width={20} height={20} class="stroke-primary stroke-2" />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>

        <p
          class="text-on-surface-variant mt-1 text-base leading-relaxed sm:text-lg"
        >
          记录思考、技术与生活。基于 Astro 与 Material Design 3
          风格打造，极简、克制、灵动。
        </p>

        {
          socials.length > 0 && (
            <div class="mt-3 flex max-sm:flex-col sm:items-center">
              <div class="text-on-surface-variant me-2 mb-1 text-sm whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- Pixel Launcher: Signature Search Pill Widget -->
    {
      config.features.search !== false && (
        <section class="my-5">
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="group bg-surface-container-high dark:bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest dark:hover:bg-surface-container-highest focus-visible:outline-primary flex w-full items-center justify-between rounded-full px-5 py-3.5 shadow-xs transition-all duration-300 ease-[cubic-bezier(0.2,0,0,1)] hover:scale-[1.01] focus-visible:outline-2 active:scale-[0.99]"
            aria-label={t.nav.search}
          >
            <div class="flex items-center gap-3">
              <div class="bg-primary/10 text-primary flex size-7 items-center justify-center rounded-full">
                <IconSearch class="size-4.5" />
              </div>
              <span class="text-on-surface-variant/80 group-hover:text-on-surface text-sm font-normal transition-colors">
                {locale === "zh"
                  ? "搜索文章、技术主题与标签..."
                  : "Search posts, topics, and tags..."}
              </span>
            </div>
            <div class="flex items-center gap-2">
              <kbd class="bg-surface-container dark:bg-surface-container text-on-surface-variant hidden size-6 items-center justify-center rounded-full px-2 font-sans text-[11px] font-medium shadow-2xs sm:inline-flex">
                /
              </kbd>
            </div>
          </a>
        </section>
      )
    }

    <!-- Recent Posts Section (Filled Tonal Island List) -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-4">
          <div class="mb-2 flex items-center justify-between px-1">
            <div class="flex items-center gap-2.5">
              <h2 class="text-on-surface text-xl font-bold tracking-tight sm:text-2xl">
                {t.home.recentPosts}
              </h2>
              <span class="bg-surface-container-high text-on-surface-variant rounded-full px-2.5 py-0.5 text-xs font-semibold">
                {recentPosts.length}
              </span>
            </div>
          </div>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="bg-secondary-container text-on-secondary-container hover:bg-primary hover:text-on-primary inline-flex items-center gap-2 rounded-full px-7 py-3 text-sm font-semibold shadow-xs transition-all duration-200 hover:shadow-md active:scale-95"
      >
        <span>{t.home.allPosts}</span>
        <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // Client-side local date update
    const dateEl = document.getElementById("pixel-at-a-glance-date");
    if (dateEl) {
      const lang = document.documentElement.lang || "zh";
      try {
        dateEl.textContent = new Intl.DateTimeFormat(
          lang === "zh" ? "zh-CN" : "en-US",
          {
            weekday: "long",
            month: "short",
            day: "numeric",
          }
        ).format(new Date());
      } catch {
        // Fallback gracefully
      }
    }

    // Quick shortcut '/' to open search
    const handleKeyDown = (e: KeyboardEvent) => {
      if (
        e.key === "/" &&
        !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName)
      ) {
        e.preventDefault();
        const searchLink = document.querySelector(
          'a[aria-label="Search"], a[href*="/search"]'
        ) as HTMLAnchorElement;
        if (searchLink) {
          searchLink.click();
        }
      }
    };
    window.addEventListener("keydown", handleKeyDown);
  });
</script>
