---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  isMobile?: boolean;
};

const { headings, isMobile = false } = Astro.props;

// Filter headings to h2, h3, h4
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

{
  toc.length > 0 && (
    <nav class:list={["toc-nav select-none", { "py-1": isMobile }]}>
      {!isMobile && (
        <div class="border-border/70 text-muted-foreground mb-3.5 flex items-center gap-2 border-b pb-2.5 text-xs font-semibold tracking-wider uppercase">
          <svg
            class="text-accent size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6h16M4 12h10M4 18h14" />
          </svg>
          <span>本文目录</span>
          <span class="bg-muted/70 text-muted-foreground ms-auto rounded-full px-2 py-0.5 font-mono text-[11px]">
            {toc.length}
          </span>
        </div>
      )}

      <ul class="max-h-[calc(100vh-10rem)] space-y-1 overflow-y-auto pr-1 text-sm">
        {toc.map(heading => {
          const depth = heading.depth;

          return (
            <li>
              <a
                href={`#${heading.slug}`}
                data-slug={heading.slug}
                class:list={[
                  "toc-link line-clamp-1 block rounded-lg border-s-2 border-transparent px-2.5 py-1.5 transition-all duration-200",
                  "hover:bg-accent/15 hover:text-accent hover:border-accent/40",
                  {
                    "text-foreground/90 text-sm font-medium": depth === 2,
                    "text-muted-foreground ps-5 text-xs font-normal":
                      depth === 3,
                    "text-muted-foreground/80 ps-8 text-xs font-normal":
                      depth === 4,
                  },
                ]}
                title={heading.text}
              >
                {heading.text}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<script>
  let removePrevScrollListener: (() => void) | null = null;

  function setupTocScrollSpy() {
    if (removePrevScrollListener) {
      removePrevScrollListener();
      removePrevScrollListener = null;
    }

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-link")
    );
    if (!links.length) return;

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(
        "article h2, article h3, article h4"
      )
    );
    if (!headings.length) return;

    // Mobile: close details on link click
    links.forEach(link => {
      link.addEventListener("click", () => {
        const details = link.closest("details");
        if (details) {
          details.removeAttribute("open");
        }
      });
    });

    let ticking = false;

    function updateActiveHeading() {
      const threshold = 110; // Under sticky header
      let currentSlug = "";

      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 50;

      if (atBottom && headings.length > 0) {
        currentSlug = headings[headings.length - 1].id;
      } else if (window.scrollY < 80) {
        currentSlug = "";
      } else {
        for (let i = 0; i < headings.length; i++) {
          const rect = headings[i].getBoundingClientRect();
          if (rect.top <= threshold) {
            currentSlug = headings[i].id;
          } else {
            break;
          }
        }
      }

      links.forEach(link => {
        const slug = link.dataset.slug;
        const isActive = slug === currentSlug;

        if (isActive) {
          link.classList.add(
            "bg-accent/15",
            "text-accent",
            "font-semibold",
            "border-accent"
          );
          link.classList.remove("border-transparent");
        } else {
          link.classList.remove(
            "bg-accent/15",
            "text-accent",
            "font-semibold",
            "border-accent"
          );
          link.classList.add("border-transparent");
        }
      });

      // Keep active heading visible inside the desktop floating sidebar's scroll container ONLY.
      // Under no circumstances call scrollIntoView() on elements, because that scrolls the entire
      // window / document and causes the page to snap back to the mobile inline TOC when scrolling down.
      if (currentSlug) {
        const desktopSidebar = document.querySelector<HTMLElement>(
          ".toc-desktop-sidebar"
        );
        if (
          desktopSidebar &&
          window.getComputedStyle(desktopSidebar).display !== "none"
        ) {
          const activeDesktopLink =
            desktopSidebar.querySelector<HTMLAnchorElement>(
              `.toc-link[data-slug="${currentSlug}"]`
            );
          if (activeDesktopLink) {
            const scrollContainer =
              activeDesktopLink.closest<HTMLElement>("ul");
            if (scrollContainer) {
              const containerRect = scrollContainer.getBoundingClientRect();
              const linkRect = activeDesktopLink.getBoundingClientRect();

              const offsetTop = linkRect.top - containerRect.top;
              const offsetBottom = linkRect.bottom - containerRect.bottom;

              if (offsetTop < 0) {
                scrollContainer.scrollTop += offsetTop - 12;
              } else if (offsetBottom > 0) {
                scrollContainer.scrollTop += offsetBottom + 12;
              }
            }
          }
        }
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    removePrevScrollListener = () => {
      window.removeEventListener("scroll", onScroll);
    };

    updateActiveHeading();
  }

  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>
