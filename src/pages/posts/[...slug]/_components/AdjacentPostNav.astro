---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    prevPost ? (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="bg-surface-container-low dark:bg-surface-container text-on-surface hover:bg-surface-container dark:hover:bg-surface-container-high flex w-full items-center gap-3 rounded-2xl p-4.5 transition-all hover:scale-[1.01] active:scale-[0.99]"
      >
        <div class="bg-surface-container-high text-primary flex size-8 shrink-0 items-center justify-center rounded-full">
          <IconArrowLeft class="size-4 rtl:rotate-180" />
        </div>
        <div class="min-w-0">
          <span class="text-on-surface-variant block text-xs font-medium">
            {t.post.previousPost}
          </span>
          <div class="text-primary mt-0.5 truncate text-sm font-semibold">
            {prevPost.title}
          </div>
        </div>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="bg-surface-container-low dark:bg-surface-container text-on-surface hover:bg-surface-container dark:hover:bg-surface-container-high flex w-full items-center justify-between gap-3 rounded-2xl p-4.5 text-end transition-all hover:scale-[1.01] active:scale-[0.99] sm:col-start-2"
      >
        <div class="min-w-0 flex-1">
          <span class="text-on-surface-variant block text-xs font-medium">
            {t.post.nextPost}
          </span>
          <div class="text-primary mt-0.5 truncate text-sm font-semibold">
            {nextPost.title}
          </div>
        </div>
        <div class="bg-surface-container-high text-primary flex size-8 shrink-0 items-center justify-center rounded-full">
          <IconArrowRight class="size-4 rtl:rotate-180" />
        </div>
      </a>
    )
  }
</div>
