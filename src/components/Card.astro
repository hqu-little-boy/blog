---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li
  class="group bg-surface-container-low dark:bg-surface-container hover:bg-surface-container dark:hover:bg-surface-container-high relative my-3.5 rounded-[24px] p-5 transition-all duration-300 ease-[cubic-bezier(0.2,0,0,1)] hover:scale-[1.01] active:scale-[0.99] sm:my-4 sm:rounded-[28px] sm:p-6.5"
>
  <a
    href={postUrl}
    class="focus-visible:outline-primary focus-visible:ring-primary/40 absolute inset-0 z-10 rounded-[24px] focus-visible:ring-2 focus-visible:outline-2 sm:rounded-[28px]"
    aria-label={title}></a>

  <div class="relative z-0">
    <div
      class="text-on-surface-variant/80 mb-2 flex items-center gap-2 text-xs sm:text-sm"
    >
      <Datetime {...props} />
    </div>

    <a
      href={postUrl}
      class="text-on-surface group-hover:text-primary transition-colors duration-200"
      tabindex="-1"
    >
      <Heading
        transition:name={toTransitionName(id)}
        class="text-lg leading-snug font-semibold tracking-tight sm:text-xl"
      >
        {title}
      </Heading>
    </a>

    <p
      class="text-on-surface-variant mt-2 line-clamp-2 text-sm leading-relaxed sm:text-base"
    >
      {description}
    </p>

    {
      tags && tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="bg-surface-container-high/90 dark:bg-surface-container-highest/50 text-on-surface-variant group-hover:bg-secondary-container group-hover:text-on-secondary-container inline-flex items-center gap-1 rounded-xl px-2.5 py-1 text-xs font-medium transition-colors">
              <span class="text-[11px] opacity-60">#</span>
              <span>{tag}</span>
            </span>
          ))}
        </div>
      )
    }
  </div>
</li>
