---
type ToolType = "latex" | "graphviz" | "mermaid" | "html" | "svg";

type Props = {
  initialTool?: ToolType;
};

const { initialTool = "latex" } = Astro.props;
---

<div
  class="tools-workspace flex w-full flex-col gap-6"
  data-initial-tool={initialTool}
>
  <!-- Top Tool Switcher (Material You Segmented Pill Bar) -->
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div
      class="bg-surface-container-low dark:bg-surface-container border-outline-variant/60 inline-flex flex-wrap gap-1 rounded-3xl border p-1.5 shadow-xs"
      role="tablist"
      aria-label="渲染工具选择"
    >
      <button
        type="button"
        role="tab"
        data-tool="latex"
        class="tool-tab-btn text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all duration-200 active:scale-95 sm:text-sm"
        aria-selected="false"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 19L11 5h9"></path>
          <path d="M8 12h10"></path>
          <path d="M4 19h16"></path>
        </svg>
        <span>LaTeX</span>
      </button>

      <button
        type="button"
        role="tab"
        data-tool="graphviz"
        class="tool-tab-btn text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all duration-200 active:scale-95 sm:text-sm"
        aria-selected="false"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="18" cy="6" r="3"></circle>
          <circle cx="12" cy="18" r="3"></circle>
          <line x1="8.5" y1="7.5" x2="15.5" y2="7.5"></line>
          <line x1="7.5" y1="8.5" x2="10.5" y2="15.5"></line>
          <line x1="16.5" y1="8.5" x2="13.5" y2="15.5"></line>
        </svg>
        <span>Graphviz</span>
      </button>

      <button
        type="button"
        role="tab"
        data-tool="mermaid"
        class="tool-tab-btn text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all duration-200 active:scale-95 sm:text-sm"
        aria-selected="false"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="8" height="6" x="8" y="2" rx="2"></rect>
          <rect width="8" height="6" x="2" y="16" rx="2"></rect>
          <rect width="8" height="6" x="14" y="16" rx="2"></rect>
          <path d="M12 8v4"></path>
          <path d="M6 16v-2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span>Mermaid</span>
      </button>

      <button
        type="button"
        role="tab"
        data-tool="html"
        class="tool-tab-btn text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all duration-200 active:scale-95 sm:text-sm"
        aria-selected="false"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>HTML</span>
      </button>

      <button
        type="button"
        role="tab"
        data-tool="svg"
        class="tool-tab-btn text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-xs font-medium transition-all duration-200 active:scale-95 sm:text-sm"
        aria-selected="false"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19 7-7 3 3-7 7-3-3z"></path>
          <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
          <path d="m2 2 7.586 7.586"></path>
          <circle cx="11" cy="11" r="2"></circle>
        </svg>
        <span>SVG</span>
      </button>
    </div>

    <!-- Tool description & Status summary -->
    <div class="text-on-surface-variant flex items-center gap-2.5 text-xs">
      <span
        id="tool-desc-badge"
        class="bg-surface-container-high dark:bg-surface-container-highest/60 rounded-full px-3 py-1 font-medium"
      >
        LaTeX 数学公式渲染
      </span>
      <span class="text-on-surface-variant/40 hidden sm:inline">•</span>
      <span class="text-on-surface-variant/70 hidden sm:inline"
        >支持实时编译与全屏独立预览</span
      >
    </div>
  </div>

  <!-- Dual-Column Workspace Container -->
  <div class="grid w-full grid-cols-1 items-start gap-5 lg:grid-cols-2">
    <!-- LEFT COLUMN: Input Area -->
    <div
      class="bg-surface-container-lowest dark:bg-surface-container-low border-outline-variant/60 flex h-[600px] flex-col overflow-hidden rounded-3xl border shadow-xs sm:h-[660px] lg:h-[720px]"
    >
      <!-- Input Header Toolbar -->
      <div
        class="bg-surface-container-low/70 dark:bg-surface-container/60 border-outline-variant/50 flex shrink-0 flex-wrap items-center justify-between gap-2.5 border-b px-4 py-3"
      >
        <div class="flex items-center gap-2.5">
          <div
            class="text-on-surface flex items-center gap-1.5 text-xs font-medium sm:text-sm"
          >
            <span class="bg-primary size-2 animate-pulse rounded-full"></span>
            <span id="input-title-label">输入代码</span>
          </div>
          <span
            id="code-stats"
            class="text-on-surface-variant/70 bg-surface-container-high/80 dark:bg-surface-container-highest/40 rounded-full px-2.5 py-0.5 font-mono text-[11px]"
          >
            1 行 · 0 字符
          </span>
        </div>

        <!-- Input Actions Toolbar -->
        <div class="flex items-center gap-1.5">
          <!-- Template selector dropdown -->
          <div class="relative inline-block text-left">
            <button
              id="template-dropdown-btn"
              type="button"
              class="m3-chip border-outline-variant/40 cursor-pointer border text-[11px] sm:text-xs"
              title="载入预置示例"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"
                ></path>
                <path d="M6 6h10"></path>
                <path d="M6 10h10"></path>
              </svg>
              <span>示例模板</span>
              <svg
                class="size-3 opacity-60"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div
              id="template-dropdown-menu"
              class="bg-surface-container dark:bg-surface-container-high border-outline-variant/70 absolute left-0 z-30 mt-1.5 hidden w-48 rounded-2xl border py-1.5 shadow-lg backdrop-blur-md sm:right-0 sm:left-auto"
            >
              <div id="template-list" class="flex flex-col">
                <!-- Dynamically populated templates -->
              </div>
            </div>
          </div>

          <!-- Copy code button -->
          <button
            id="copy-code-btn"
            type="button"
            class="m3-chip cursor-pointer text-[11px] sm:text-xs"
            title="复制源码"
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              ></path>
            </svg>
            <span id="copy-code-text">复制</span>
          </button>

          <!-- Clear code button -->
          <button
            id="clear-code-btn"
            type="button"
            class="m3-chip text-on-surface-variant cursor-pointer text-[11px] hover:bg-red-500/10 hover:text-red-500 sm:text-xs"
            title="清空输入"
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 6h18"></path>
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
            </svg>
            <span>清空</span>
          </button>
        </div>
      </div>

      <!-- Code Editor Area with Line Numbers Gutter -->
      <div
        class="bg-surface-container-lowest dark:bg-surface-container-low relative flex min-h-0 flex-1 overflow-hidden"
      >
        <!-- Line Numbers Gutter -->
        <div
          id="editor-gutter"
          class="bg-surface-container-low/40 dark:bg-surface-container/30 border-outline-variant/30 text-on-surface-variant/40 h-full w-10 shrink-0 overflow-hidden border-r py-3.5 pr-2 text-right font-mono text-xs leading-relaxed select-none sm:w-12"
          aria-hidden="true"
        >
          1
        </div>

        <!-- Textarea Code Input -->
        <textarea
          id="code-editor"
          class="text-on-surface selection:bg-primary-container selection:text-on-primary-container h-full w-full flex-1 resize-none overflow-y-auto bg-transparent p-3.5 font-mono text-xs leading-relaxed focus:outline-hidden sm:text-sm"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          placeholder="在此输入代码..."
          style="tab-size: 2;"></textarea>
      </div>

      <!-- Editor Footer Status / Shortcuts hint -->
      <div
        class="bg-surface-container-low/40 dark:bg-surface-container/30 border-outline-variant/40 text-on-surface-variant/60 flex shrink-0 items-center justify-between border-t px-4 py-2 text-[11px] select-none"
      >
        <div class="flex items-center gap-2">
          <span>Tab 缩进 2 空格</span>
          <span>•</span>
          <span>实时自动渲染</span>
        </div>
        <div class="flex items-center gap-1">
          <kbd
            class="bg-surface-container-high dark:bg-surface-container-highest/60 rounded px-1.5 py-0.5 font-mono text-[10px]"
            >Ctrl</kbd
          >
          <span>+</span>
          <kbd
            class="bg-surface-container-high dark:bg-surface-container-highest/60 rounded px-1.5 py-0.5 font-mono text-[10px]"
            >Enter</kbd
          >
          <span>即刻重新编译</span>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Render Preview Area -->
    <div
      class="bg-surface-container-lowest dark:bg-surface-container-low border-outline-variant/60 flex h-[600px] flex-col overflow-hidden rounded-3xl border shadow-xs sm:h-[660px] lg:h-[720px]"
    >
      <!-- Preview Header Toolbar -->
      <div
        class="bg-surface-container-low/70 dark:bg-surface-container/60 border-outline-variant/50 flex shrink-0 flex-wrap items-center justify-between gap-2.5 border-b px-4 py-3"
      >
        <div class="flex items-center gap-2.5">
          <div
            class="text-on-surface flex items-center gap-1.5 text-xs font-medium sm:text-sm"
          >
            <svg
              class="text-primary size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span>渲染预览</span>
          </div>

          <!-- Status badge -->
          <div
            id="render-status-badge"
            class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-medium text-emerald-600 dark:text-emerald-400"
          >
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span id="render-status-text">已渲染</span>
          </div>
        </div>

        <!-- Preview Actions Toolbar -->
        <div class="flex items-center gap-2">
          <!-- Zoom Controls (for SVG / Graphviz / Mermaid) -->
          <div
            id="diagram-zoom-bar"
            class="bg-surface-container-high/70 dark:bg-surface-container-highest/50 border-outline-variant/40 hidden items-center gap-0.5 rounded-full border p-0.5"
          >
            <button
              id="zoom-in-btn"
              type="button"
              class="text-on-surface-variant hover:text-on-surface hover:bg-surface-container cursor-pointer rounded-full p-1 transition-colors"
              title="放大 (+)"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
            <button
              id="zoom-out-btn"
              type="button"
              class="text-on-surface-variant hover:text-on-surface hover:bg-surface-container cursor-pointer rounded-full p-1 transition-colors"
              title="缩小 (-)"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
            <button
              id="zoom-reset-btn"
              type="button"
              class="text-on-surface-variant hover:text-on-surface hover:bg-surface-container cursor-pointer rounded-full p-1 transition-colors"
              title="还原缩放"
            >
              <svg
                class="size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                ></path>
                <path d="M3 3v5h5"></path>
              </svg>
            </button>
          </div>

          <!-- Download Image Dropdown (for latex, graphviz, mermaid, svg) -->
          <div
            id="download-dropdown-wrapper"
            class="relative inline-block text-left"
          >
            <button
              id="download-dropdown-btn"
              type="button"
              class="m3-chip border-outline-variant/40 cursor-pointer border text-[11px] sm:text-xs"
              title="下载图片 (PNG / SVG)"
            >
              <svg
                class="text-primary size-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>下载图片</span>
              <svg
                class="size-3 opacity-60"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div
              id="download-dropdown-menu"
              class="bg-surface-container dark:bg-surface-container-high border-outline-variant/70 absolute right-0 z-30 mt-1.5 hidden w-44 rounded-2xl border py-1.5 shadow-lg backdrop-blur-md"
            >
              <button
                id="download-png-btn"
                type="button"
                class="hover:bg-surface-container-highest/80 flex w-full cursor-pointer items-center justify-between gap-2 px-3.5 py-2 text-left text-xs transition-colors"
              >
                <div class="flex items-center gap-2">
                  <svg
                    class="text-primary size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"
                    ></rect>
                    <circle cx="9" cy="9" r="2"></circle>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                  </svg>
                  <span class="text-on-surface font-medium">下载 PNG 图片</span>
                </div>
                <span class="text-on-surface-variant/60 font-mono text-[10px]"
                  >.png</span
                >
              </button>
              <button
                id="download-svg-btn"
                type="button"
                class="hover:bg-surface-container-highest/80 flex w-full cursor-pointer items-center justify-between gap-2 px-3.5 py-2 text-left text-xs transition-colors"
              >
                <div class="flex items-center gap-2">
                  <svg
                    class="text-primary size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                  <span class="text-on-surface font-medium">下载 SVG 矢量</span>
                </div>
                <span class="text-on-surface-variant/60 font-mono text-[10px]"
                  >.svg</span
                >
              </button>
            </div>
          </div>

          <!-- PROMINENT BUTTON: Open in New Tab (graphviz, mermaid, html, svg) -->
          <button
            id="open-new-tab-btn"
            type="button"
            class="bg-primary text-on-primary hover:bg-primary/90 inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold shadow-xs transition-all duration-200 active:scale-95"
            title="在新标签页中全屏展示（只展示预览内容）"
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>在新标签页展示</span>
          </button>
        </div>
      </div>

      <!-- Preview Canvas Area -->
      <div
        class="bg-surface-container-lowest dark:bg-surface-container-low relative flex min-h-0 flex-1 flex-col items-center justify-center overflow-hidden p-4 sm:p-6"
      >
        <!-- Error Notice Banner (Hidden when no error) -->
        <div
          id="preview-error-panel"
          class="animate-fade-in mx-auto mb-3 hidden max-h-36 w-full max-w-xl shrink-0 overflow-y-auto rounded-2xl border border-red-500/30 bg-red-500/10 p-3.5 text-xs text-red-600 sm:text-sm dark:text-red-400"
        >
          <div class="flex items-start gap-2.5">
            <svg
              class="mt-0.5 size-5 shrink-0 text-red-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div class="flex-1 overflow-hidden">
              <div class="mb-1 font-semibold">渲染出错</div>
              <pre
                id="preview-error-message"
                class="font-mono text-xs break-all whitespace-pre-wrap opacity-90">
              </pre>
            </div>
          </div>
        </div>

        <!-- Render Target Viewport -->
        <div
          id="preview-viewport"
          class="flex h-full min-h-0 w-full flex-1 items-center justify-center overflow-auto"
        >
          <!-- Content dynamically rendered here -->
          <div
            id="preview-content"
            class="flex h-full w-full items-center justify-center"
          >
          </div>
        </div>
      </div>

      <!-- Preview Footer -->
      <div
        class="bg-surface-container-low/40 dark:bg-surface-container/30 border-outline-variant/40 text-on-surface-variant/60 flex items-center justify-between border-t px-4 py-2 text-[11px] select-none"
      >
        <div class="flex items-center gap-2">
          <span id="preview-format-hint">矢量 SVG 渲染模式</span>
        </div>
        <div class="flex items-center gap-2">
          <span>点击右上角按钮弹出纯净新标签页</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import katex from "katex";

  // Types & Data Structures
  type ToolType = "latex" | "graphviz" | "mermaid" | "html" | "svg";

  interface PresetTemplate {
    name: string;
    description: string;
    code: string;
  }

  const TEMPLATES: Record<ToolType, PresetTemplate[]> = {
    latex: [
      {
        name: "高斯积分 & 麦克斯韦方程组",
        description: "积分与经典电动力学偏微分方程",
