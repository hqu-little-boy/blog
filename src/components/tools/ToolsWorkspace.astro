          setTimeout(() => {
            copyText.innerText = original;
            copyBtn.classList.remove(
              "bg-secondary-container",
              "text-on-secondary-container"
            );
          }, 1500);
        }
      } catch {
        // Ignore clipboard failure
      }
    });

    // Clear Code
    clearBtn?.addEventListener("click", () => {
      if (!editor) return;
      editor.value = "";
      updateGutter();
      try {
        localStorage.removeItem(`tools_draft_${currentTool}`);
      } catch {}
      performRender();
    });

    // Zoom Controls
    function setZoom(scale: number) {
      currentScale = Math.max(0.2, Math.min(4, scale));
      const target = previewContent?.querySelector("svg") as SVGElement | null;
      if (target) {
        target.style.transform = `scale(${currentScale})`;
        target.style.transformOrigin = "center center";
        target.style.transition = "transform 0.15s ease-out";
      }
    }

    zoomInBtn?.addEventListener("click", () => setZoom(currentScale + 0.15));
    zoomOutBtn?.addEventListener("click", () => setZoom(currentScale - 0.15));
    zoomResetBtn?.addEventListener("click", () => setZoom(1));

