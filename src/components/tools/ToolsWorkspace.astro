    if (!editor || !previewContent) return;

    // Helper: update line numbers gutter
    function updateGutter() {
      if (!editor || !gutter) return;
      const lines = editor.value.split("\n").length;
      let numbers = "";
      for (let i = 1; i <= lines; i++) {
        numbers += i + "\n";
      }
      gutter.innerText = numbers;

      // Update stats
      if (codeStats) {
        codeStats.innerText = `${lines} 行 · ${editor.value.length} 字符`;
      }
    }

    // Sync scroll between textarea and gutter
    editor.addEventListener("scroll", () => {
      if (gutter) gutter.scrollTop = editor.scrollTop;
    });

    // Handle Tab key
    editor.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = editor.selectionStart;
        const end = editor.selectionEnd;
        editor.value =
          editor.value.substring(0, start) + "  " + editor.value.substring(end);
        editor.selectionStart = editor.selectionEnd = start + 2;
        updateGutter();
        scheduleRender();
      } else if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        performRender();
      }
    });

    // Textarea input event
    editor.addEventListener("input", () => {
      updateGutter();
      // Save draft to localStorage
      try {
        localStorage.setItem(`tools_draft_${currentTool}`, editor.value);
      } catch {}
      scheduleRender();
    });

    // Template Dropdown Toggle
    templateBtn?.addEventListener("click", e => {
      e.stopPropagation();
      downloadMenu?.classList.add("hidden");
      templateMenu?.classList.toggle("hidden");
