    if (!container) return;

    // Detect initial tool from URL or data attribute
    const urlParams = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace(/^#/, "").toLowerCase();
    const paramTool = urlParams.get("tool") || urlParams.get("type");

    // Check path for /tools/xxx
    const pathSegments = window.location.pathname.split("/").filter(Boolean);
    const lastSegment = pathSegments[pathSegments.length - 1]?.toLowerCase();

    let resolvedTool: ToolType =
      (container.dataset.initialTool as ToolType) || "latex";

    if (
      paramTool &&
      ["latex", "graphviz", "mermaid", "html", "svg"].includes(paramTool)
    ) {
      resolvedTool = paramTool as ToolType;
    } else if (
      hash &&
      ["latex", "graphviz", "mermaid", "html", "svg"].includes(hash)
    ) {
      resolvedTool = hash as ToolType;
    } else if (
      lastSegment &&
      ["latex", "graphviz", "mermaid", "html", "svg"].includes(lastSegment)
    ) {
      resolvedTool = lastSegment as ToolType;
    }

