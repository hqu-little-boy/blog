    function selectTool(tool: ToolType) {
      currentTool = tool;
      currentScale = 1;

      // Update tab buttons
      const tabs =
        container?.querySelectorAll<HTMLButtonElement>(".tool-tab-btn");
      tabs?.forEach(btn => {
        const isMatch = btn.dataset.tool === tool;
        btn.setAttribute("aria-selected", isMatch ? "true" : "false");
        if (isMatch) {
          btn.className =
            "tool-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 active:scale-95 cursor-pointer bg-primary text-on-primary shadow-xs";
        } else {
          btn.className =
            "tool-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm font-medium transition-all duration-200 active:scale-95 cursor-pointer text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high";
        }
      });

      // Update descriptions
      const info = TOOL_INFO[tool];
      if (toolDescBadge) toolDescBadge.innerText = info.desc;
      if (inputTitleLabel) inputTitleLabel.innerText = info.inputLabel;
      if (previewFormatHint) previewFormatHint.innerText = info.hint;

      // Show or hide Zoom toolbar (only for diagrams)
      if (zoomBar) {
        if (["graphviz", "mermaid", "svg"].includes(tool)) {
          zoomBar.classList.remove("hidden");
          zoomBar.classList.add("flex");
        } else {
          zoomBar.classList.add("hidden");
          zoomBar.classList.remove("flex");
        }
      }

      // Show or hide Download button (for latex, graphviz, mermaid, svg)
      if (downloadDropdownWrapper) {
        if (["latex", "graphviz", "mermaid", "svg"].includes(tool)) {
          downloadDropdownWrapper.classList.remove("hidden");
          downloadDropdownWrapper.classList.add("inline-block");
        } else {
          downloadDropdownWrapper.classList.add("hidden");
          downloadDropdownWrapper.classList.remove("inline-block");
        }
      }

      // Populate templates for new tool
      populateTemplates();

      // Load saved draft or default template
      let codeToLoad = "";
      try {
        const saved = localStorage.getItem(`tools_draft_${tool}`);
        if (saved !== null && saved.trim()) {
          codeToLoad = saved;
        }
      } catch {}

      if (!codeToLoad) {
        codeToLoad = TEMPLATES[tool][0]?.code || "";
      }

      if (editor) {
        editor.value = codeToLoad;
        updateGutter();
      }

      // Update URL without reloading
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set("tool", tool);
      window.history.replaceState({ tool }, "", newUrl.toString());

      // Perform render
      performRender();
    }

    // Tab buttons click listeners
    const tabButtons =
      container.querySelectorAll<HTMLButtonElement>(".tool-tab-btn");
    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetTool = btn.dataset.tool as ToolType;
        if (targetTool && targetTool !== currentTool) {
          selectTool(targetTool);
        }
      });
    });

    // Debounced scheduling
    function scheduleRender() {
      if (renderDebounceTimer) clearTimeout(renderDebounceTimer);
      if (statusBadge && statusText) {
        statusBadge.className =
          "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400";
        statusText.innerText = "编译中...";
      }
      renderDebounceTimer = setTimeout(() => {
        performRender();
      }, 250);
    }

    // Core Render Dispatcher
    async function performRender() {
      if (!editor || !previewContent) return;
      const rawCode = editor.value.trim();

      // Reset error panel
      if (errorPanel) errorPanel.classList.add("hidden");
      if (errorMessage) errorMessage.innerText = "";

      if (!rawCode) {
        previewContent.innerHTML = `<div class="text-on-surface-variant/50 text-xs italic text-center py-12">暂无代码输入，请在左侧输入或载入示例模板</div>`;
        currentRenderedOutput = "";
        if (statusBadge && statusText) {
          statusBadge.className =
            "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-surface-container-high text-on-surface-variant";
          statusText.innerText = "等待输入";
        }
        return;
      }

      try {
        let outputHtml = "";

        if (currentTool === "latex") {
          outputHtml = renderLatex(rawCode);
          previewContent.innerHTML = `<div class="katex-preview-box w-full max-w-full overflow-x-auto py-6 px-4 flex items-center justify-center text-center">${outputHtml}</div>`;
          currentRenderedOutput = outputHtml;
        } else if (currentTool === "graphviz") {
          outputHtml = await renderGraphviz(rawCode);
          previewContent.innerHTML = `<div class="graphviz-preview-box w-full h-full flex items-center justify-center overflow-auto">${outputHtml}</div>`;
          currentRenderedOutput = outputHtml;
        } else if (currentTool === "mermaid") {
          outputHtml = await renderMermaid(rawCode);
          previewContent.innerHTML = `<div class="mermaid-preview-box w-full h-full flex items-center justify-center overflow-auto">${outputHtml}</div>`;
          currentRenderedOutput = outputHtml;
        } else if (currentTool === "html") {
          renderHtmlInIframe(previewContent, rawCode);
          currentRenderedOutput = rawCode;
        } else if (currentTool === "svg") {
          outputHtml = renderSvg(rawCode);
          previewContent.innerHTML = `<div class="svg-preview-box w-full h-full flex items-center justify-center overflow-auto">${outputHtml}</div>`;
          currentRenderedOutput = outputHtml;
        }

        // Apply scale if diagram
        if (["graphviz", "mermaid", "svg"].includes(currentTool)) {
          setZoom(currentScale);
        }

        if (statusBadge && statusText) {
          statusBadge.className =
            "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";
          statusText.innerText = "已渲染";
        }
      } catch (err: any) {
        if (errorPanel && errorMessage) {
          errorPanel.classList.remove("hidden");
          errorMessage.innerText = err.message || String(err);
        }
        if (statusBadge && statusText) {
          statusBadge.className =
            "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-red-500/10 text-red-600 dark:text-red-400";
          statusText.innerText = "语法错误";
        }
      }
    }

    // 1. LaTeX Renderer
    function renderLatex(code: string): string {
      return katex.renderToString(code, {
        displayMode: true,
        throwOnError: true,
      });
    }

    // 2. Graphviz Renderer (WASM)
    async function renderGraphviz(dotCode: string): Promise<string> {
      if (!graphvizInstance) {
        const { Graphviz } = await import("@hpcc-js/wasm-graphviz");
        graphvizInstance = await Graphviz.load();
      }
      return graphvizInstance.dot(dotCode, "svg");
    }

    // 3. Mermaid Renderer
    async function renderMermaid(mermaidCode: string): Promise<string> {
      const { default: mermaid } = await import("mermaid");
      const isDark =
        document.firstElementChild?.getAttribute("data-theme") === "dark";

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "loose",
        theme: isDark ? "dark" : "base",
        themeVariables: isDark
          ? {
              darkMode: true,
              background: "transparent",
              mainBkg: "#24272b",
              primaryColor: "#24272b",
              primaryTextColor: "#e3e2e6",
              primaryBorderColor: "#55d6ec",
              lineColor: "#55d6ec",
            }
          : {
              background: "transparent",
              primaryColor: "#f1f5f3",
              primaryTextColor: "#181d1c",
              primaryBorderColor: "#006877",
              lineColor: "#006877",
            },
      });

      const uniqueId = `mermaid-render-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`;
      const { svg } = await mermaid.render(uniqueId, mermaidCode);
      return svg;
    }

    // 4. HTML Renderer (Sandboxed iframe)
    function renderHtmlInIframe(containerEl: HTMLElement, htmlCode: string) {
      containerEl.innerHTML = "";
      const iframe = document.createElement("iframe");
      iframe.className =
        "w-full h-full min-h-[460px] border-0 rounded-2xl bg-white";
      iframe.setAttribute(
        "sandbox",
        "allow-scripts allow-modals allow-same-origin"
      );

      const doc = /<!doctype|<html/i.test(htmlCode)
        ? htmlCode
        : `<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><style>body{margin:0;padding:16px;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;}</style></head><body>${htmlCode}</body></html>`;

      iframe.srcdoc = doc;
      containerEl.appendChild(iframe);
    }

    // 5. SVG Renderer
    function renderSvg(svgCode: string): string {
      const parser = new DOMParser();
      const xmlDoc = parser.parseFromString(svgCode, "image/svg+xml");
      const parserError = xmlDoc.querySelector("parsererror");
      if (parserError) {
        throw new Error(parserError.textContent || "SVG 格式不正确");
      }
      return svgCode;
    }

    // Download helpers
    function downloadBlob(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function downloadText(text: string, filename: string, mimeType: string) {
      const blob = new Blob([text], { type: mimeType });
      downloadBlob(blob, filename);
    }

    function getSvgDimensions(svgEl: SVGElement): {
      width: number;
      height: number;
    } {
      const viewBox = svgEl.getAttribute("viewBox");
      if (viewBox) {
        const parts = viewBox
          .trim()
          .split(/[\s,]+/)
          .map(Number);
        if (parts.length >= 4 && parts[2] > 0 && parts[3] > 0) {
          return { width: Math.round(parts[2]), height: Math.round(parts[3]) };
        }
      }
      const rect = svgEl.getBoundingClientRect();
      if (rect.width > 20 && rect.height > 20) {
        return {
          width: Math.round(rect.width),
          height: Math.round(rect.height),
        };
      }
      const wAttr = svgEl.getAttribute("width");
      const hAttr = svgEl.getAttribute("height");
      const wNum = parseFloat(wAttr || "0");
      const hNum = parseFloat(hAttr || "0");
      if (wNum > 0 && hNum > 0 && !wAttr?.includes("%")) {
        return { width: Math.round(wNum), height: Math.round(hNum) };
      }
      return { width: 800, height: 600 };
    }

    function renderSvgStringToPng(
      svgString: string,
      baseWidth: number,
      baseHeight: number,
      filename: string
    ) {
      const isDark =
        document.firstElementChild?.getAttribute("data-theme") === "dark";
      const scale = 2; // Crisp 2x retina
      const width = Math.max(100, Math.ceil(baseWidth));
      const height = Math.max(50, Math.ceil(baseHeight));

      let preparedSvg = svgString;
      if (!preparedSvg.includes('xmlns="http://www.w3.org/2000/svg"')) {
        preparedSvg = preparedSvg.replace(
          "<svg",
          '<svg xmlns="http://www.w3.org/2000/svg"'
        );
      }
      preparedSvg = preparedSvg
        .replace(/\bwidth="[^"]*"/, `width="${width}"`)
        .replace(/\bheight="[^"]*"/, `height="${height}"`);
      if (!/\bwidth=/.test(preparedSvg)) {
        preparedSvg = preparedSvg.replace("<svg", `<svg width="${width}"`);
      }
      if (!/\bheight=/.test(preparedSvg)) {
        preparedSvg = preparedSvg.replace("<svg", `<svg height="${height}"`);
      }

      const canvas = document.createElement("canvas");
      canvas.width = width * scale;
      canvas.height = height * scale;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      ctx.fillStyle = isDark ? "#0e1515" : "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const img = new Image();
      const blob = new Blob([preparedSvg], {
        type: "image/svg+xml;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);

      img.onload = () => {
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        URL.revokeObjectURL(url);
        try {
          canvas.toBlob(pngBlob => {
            if (pngBlob) {
              downloadBlob(pngBlob, filename);
            }
          }, "image/png");
        } catch {
          downloadText(
            svgString,
            filename.replace(/\.png$/, ".svg"),
            "image/svg+xml;charset=utf-8"
          );
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        downloadText(
          svgString,
          filename.replace(/\.png$/, ".svg"),
          "image/svg+xml;charset=utf-8"
        );
      };
      img.src = url;
    }

    async function handleDownload(format: "png" | "svg") {
      if (!previewContent) return;
      const isDark =
        document.firstElementChild?.getAttribute("data-theme") === "dark";
      const timestamp = Date.now();
      const baseName = `${currentTool}-${timestamp}`;

      if (currentTool === "latex") {
        const katexEl = previewContent.querySelector(
          ".katex"
        ) as HTMLElement | null;
        if (!katexEl) return;

        const rect = katexEl.getBoundingClientRect();
        const width = Math.max(160, Math.ceil(rect.width) + 40);
        const height = Math.max(80, Math.ceil(rect.height) + 40);
        const bgColor = isDark ? "#0e1515" : "#ffffff";
        const textColor = isDark ? "#e3e2e6" : "#181d1c";

        let katexRules = "";
        for (const sheet of Array.from(document.styleSheets)) {
          try {
            for (const rule of Array.from(sheet.cssRules || [])) {
              if (
                rule.cssText &&
                rule.cssText.includes("katex") &&
                !rule.cssText.startsWith("@font-face")
              ) {
                katexRules += rule.cssText + "\n";
              }
            }
          } catch {}
        }

        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">
<style>
${katexRules}
.math-svg-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: ${bgColor};
  color: ${textColor};
  font-family: KaTeX_Main, "Times New Roman", "Cambria Math", serif;
  font-size: 22px;
}
.katex-display { margin: 0; }
</style>
<foreignObject width="100%" height="100%">
  <div xmlns="http://www.w3.org/1999/xhtml" class="math-svg-box">
    ${katexEl.outerHTML}
  </div>
</foreignObject>
</svg>`;

        if (format === "svg") {
          downloadText(
            svgString,
            `${baseName}.svg`,
            "image/svg+xml;charset=utf-8"
          );
        } else {
          renderSvgStringToPng(svgString, width, height, `${baseName}.png`);
        }
      } else if (["graphviz", "mermaid", "svg"].includes(currentTool)) {
        const svgEl = previewContent.querySelector("svg") as SVGElement | null;
        if (!svgEl) return;

        let svgString = svgEl.outerHTML;
        if (!svgString.includes('xmlns="http://www.w3.org/2000/svg"')) {
          svgString = svgString.replace(
            "<svg",
            '<svg xmlns="http://www.w3.org/2000/svg"'
          );
        }

        if (format === "svg") {
          downloadText(
            svgString,
            `${baseName}.svg`,
            "image/svg+xml;charset=utf-8"
          );
        } else {
          const { width, height } = getSvgDimensions(svgEl);
          renderSvgStringToPng(svgString, width, height, `${baseName}.png`);
        }
      }
    }

    // Start with resolved tool
    selectTool(resolvedTool);
  }

  // Open Preview in New Tab Function
  function openPreviewInNewTab(
    tool: ToolType,
    renderedContent: string,
    rawCode: string
  ) {
    let fullHtml = "";

    if (tool === "html") {
      fullHtml = /<!doctype|<html/i.test(rawCode)
        ? rawCode
        : `<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HTML 预览</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Noto Sans SC", sans-serif;
    }
  </style>
</head>
<body>
  ${rawCode}
</body>
</html>`;
    } else if (tool === "graphviz" || tool === "mermaid" || tool === "svg") {
      fullHtml = `<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${tool.toUpperCase()} 矢量图表预览</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0e1515;
      color: #e3e2e6;
      overflow: auto;
    }
    @media (prefers-color-scheme: light) {
      html, body {
        background: #f7faf9;
        color: #181d1c;
      }
    }
    .preview-stage {
      max-width: 100%;
      max-height: 100%;
      padding: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    svg {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
    }
  </style>
</head>
<body>
  <div class="preview-stage">
    ${renderedContent}
  </div>
</body>
</html>`;
    } else if (tool === "latex") {
      fullHtml = `<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LaTeX 数学公式预览</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0e1515;
      color: #e3e2e6;
    }
    @media (prefers-color-scheme: light) {
      html, body {
        background: #f7faf9;
        color: #181d1c;
      }
    }
    .math-stage {
      padding: 48px 24px;
      font-size: 1.75rem;
      text-align: center;
      max-width: 90vw;
      overflow-x: auto;
    }
  </style>
</head>
<body>
  <div class="math-stage">
    ${renderedContent}
  </div>
</body>
</html>`;
    }

    try {
      const blob = new Blob([fullHtml], { type: "text/html;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      window.open(url, "_blank");
      setTimeout(() => URL.revokeObjectURL(url), 60000);
    } catch {
      // Fallback
      const newWin = window.open("", "_blank");
      if (newWin) {
        newWin.document.documentElement.innerHTML = fullHtml;
      }
    }
  }

  // Bind to lifecycle
  document.addEventListener("astro:page-load", initToolsWorkspace);
</script>

