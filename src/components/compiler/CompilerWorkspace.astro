  function getAsmPills(lang: string, target: string): FlagPill[] {
    const family = lang === "rust" ? "rust" : "cc";
    return (
      ASM_ARCH_PILLS[family]?.[target] || ASM_ARCH_PILLS[family]?.g142 || []
    );
  }

  function stripAnsi(str: string): string {
    return str.replace(/\x1b\[[0-9;]*[a-zA-Z]/g, "");
  }

  function formatLines(lines?: any[]): string {
    if (!lines || !Array.isArray(lines)) return "";
    return lines.map(line => stripAnsi(line.text ?? "")).join("\n");
  }

  function initCompilerWorkspace() {
    const root = document.getElementById("compiler-root");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    // Elements
    const langSelect = document.getElementById(
      "lang-select"
    ) as HTMLSelectElement;
    const asmArgsInput = document.getElementById(
      "asm-args"
    ) as HTMLInputElement;
    const btnAsmArgsReset = document.getElementById(
      "btn-asm-args-reset"
    ) as HTMLButtonElement;
    const asmFlagPills = document.getElementById(
      "asm-flag-pills"
    ) as HTMLElement;
    const execArgsInput = document.getElementById(
      "exec-args"
    ) as HTMLInputElement;
    const btnExecArgsReset = document.getElementById(
      "btn-exec-args-reset"
    ) as HTMLButtonElement;
    const execFlagPills = document.getElementById(
      "exec-flag-pills"
    ) as HTMLElement;
    const btnAsm = document.getElementById("btn-asm") as HTMLButtonElement;
    const asmBtnIcon = document.getElementById("asm-btn-icon") as HTMLElement;
    const asmSpinIcon = document.getElementById("asm-spin-icon") as HTMLElement;
    const btnRun = document.getElementById("btn-run") as HTMLButtonElement;
    const runPlayIcon = document.getElementById("run-play-icon") as HTMLElement;
    const runSpinIcon = document.getElementById("run-spin-icon") as HTMLElement;
    const btnShare = document.getElementById("btn-share") as HTMLButtonElement;
    const btnFullscreen = document.getElementById(
      "btn-fullscreen"
    ) as HTMLButtonElement;
    const iconFsEnter = document.getElementById("icon-fs-enter") as HTMLElement;
    const iconFsExit = document.getElementById("icon-fs-exit") as HTMLElement;

    const sourceEditor = document.getElementById(
      "source-editor"
    ) as HTMLTextAreaElement;
    const sourceGutter = document.getElementById(
      "source-gutter"
    ) as HTMLElement;
    const sourceBadge = document.getElementById("source-badge") as HTMLElement;
    const sourceStats = document.getElementById("source-stats") as HTMLElement;
    const sourceActiveHighlight = document.getElementById(
      "source-active-highlight"
    ) as HTMLElement;
    const btnSourceClear = document.getElementById(
      "btn-source-clear"
    ) as HTMLButtonElement;
    const btnSourceCopy = document.getElementById(
      "btn-source-copy"
    ) as HTMLButtonElement;

    const asmCompilerSelect = document.getElementById(
      "asm-compiler-select"
    ) as HTMLSelectElement;
    const btnAsmCopy = document.getElementById(
      "btn-asm-copy"
    ) as HTMLButtonElement;
    const filterDirectives = document.getElementById(
      "filter-directives"
    ) as HTMLInputElement;
    const filterComments = document.getElementById(
      "filter-comments"
    ) as HTMLInputElement;
    const filterDemangle = document.getElementById(
      "filter-demangle"
    ) as HTMLInputElement;
    const asmOutput = document.getElementById("asm-output") as HTMLElement;
    const asmGutter = document.getElementById("asm-gutter") as HTMLElement;
    const asmStats = document.getElementById("asm-stats") as HTMLElement;
    const asmTime = document.getElementById("asm-time") as HTMLElement;
    const asmLinkIndicator = document.getElementById(
      "asm-link-indicator"
    ) as HTMLElement;
    const asmLinkText = document.getElementById("asm-link-text") as HTMLElement;

    const btnToggleStdin = document.getElementById(
      "btn-toggle-stdin"
    ) as HTMLButtonElement;
    const stdinPanel = document.getElementById("stdin-panel") as HTMLElement;
    const stdinInput = document.getElementById(
      "stdin-input"
    ) as HTMLTextAreaElement;
    const btnExecClear = document.getElementById(
      "btn-exec-clear"
