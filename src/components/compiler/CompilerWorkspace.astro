  }

  .source-gutter-item.is-active-line {
    color: #0284c7 !important;
    font-weight: 700 !important;
    background-color: rgba(14, 165, 233, 0.15) !important;
  }

  :global([data-theme="dark"]) .source-gutter-item.is-active-line {
