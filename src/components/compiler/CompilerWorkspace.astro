    z-index: 100 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    padding: 1rem !important;
    background-color: var(--md-surface, #ffffff);
    overflow: hidden !important;
  }

  :global([data-theme="dark"]) .compiler-fullscreen {
    background-color: var(--md-surface, #111418);
  }

  .compiler-fullscreen #columns-container {
    height: calc(100vh - 6rem) !important;
  }

  /* Interactive Assembly Line Styles (using :global to style dynamic elements) */
  :global(.asm-line-item) {
    box-sizing: border-box !important;
    border-left: 3px solid transparent !important;
    transition:
      background-color 0.1s ease,
      border-left-color 0.1s ease;
  }

  :global(.asm-line-item.is-linked-asm-line) {
    background-color: rgba(14, 165, 233, 0.32) !important;
