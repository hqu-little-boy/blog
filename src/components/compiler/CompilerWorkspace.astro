    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    padding: 1rem !important;
    background-color: var(--md-surface, #ffffff);
    overflow: hidden !important;
  }

  :global([data-theme="dark"]) .compiler-fullscreen {
    background-color: var(--md-surface, #111418);
  }

  .compiler-fullscreen #columns-container {
    height: calc(100vh - 6rem) !important;
  }

  /* Interactive Assembly Line Styles */
  .asm-line-item {
    box-sizing: border-box;
    border-left: 3px solid transparent;
  }

  .asm-line-item.is-linked-asm-line {
    background-color: rgba(14, 165, 233, 0.22) !important;
    border-left-color: #38bdf8 !important;
    color: #ffffff !important;
  }

  .asm-gutter-item.is-active-line {
    color: #38bdf8 !important;
    font-weight: 700 !important;
