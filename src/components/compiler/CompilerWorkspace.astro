    let isCompilingAsm = false;
    let isRunningExec = false;

    // Bidirectional Mapping State
    const PADDING_TOP = 14; // py-3.5 = 14px
    const LINE_HEIGHT = 24; // leading-6 = 24px
    const sourceToAsmMap = new Map<number, number[]>();
    let currentHighlightedSourceLine: number | null = null;
    let currentRawAsmText = "";

    // Toast helper
    function showToast(msg: string) {
      if (!toast) return;
      toast.innerText = msg;
      toast.classList.remove("opacity-0", "pointer-events-none");
      toast.classList.add("opacity-100");
      setTimeout(() => {
        toast.classList.remove("opacity-100");
        toast.classList.add("opacity-0", "pointer-events-none");
      }, 2200);
    }

    // Update Source Gutter Line Numbers
    function updateSourceGutter() {
      if (!sourceEditor || !sourceGutter) return;
      const lines = sourceEditor.value.split("\n").length;
      let gutterHtml = "";
      for (let i = 1; i <= lines; i++) {
        gutterHtml += `<div class="source-gutter-item h-6 leading-6 cursor-pointer hover:text-sky-500 transition-colors" data-source-line="${i}">${i}</div>`;
      }
      sourceGutter.innerHTML = gutterHtml;
      if (sourceStats) {
        sourceStats.innerText = `${lines} 行, ${sourceEditor.value.length} 字符`;
      }
    }

    // Handle Tab & Indentation in Editor
    sourceEditor?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Tab") {
        e.preventDefault();
        const start = sourceEditor.selectionStart;
        const end = sourceEditor.selectionEnd;
        sourceEditor.value =
          sourceEditor.value.substring(0, start) +
          "  " +
          sourceEditor.value.substring(end);
        sourceEditor.selectionStart = sourceEditor.selectionEnd = start + 2;
        clearAllHighlights();
        updateSourceGutter();
      } else if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        runExecution();
      } else if (e.key === "Enter" && e.altKey) {
        e.preventDefault();
        compileAssembly();
      }
    });

    sourceEditor?.addEventListener("input", () => {
      clearAllHighlights();
      updateSourceGutter();
    });

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    // Assembly Syntax Formatter for a single line
    function highlightAssemblyLine(lineText: string): string {
      const cleanLine = stripAnsi(lineText);
      const trimmed = cleanLine.trim();

      // Comment line
      if (trimmed.startsWith(";") || trimmed.startsWith("#")) {
        return `<span class="text-slate-500 italic">${escapeHtml(cleanLine)}</span>`;
      }
      // Label definition
      if (/^[a-zA-Z0-9_$.]+:/.test(trimmed)) {
        return `<span class="text-amber-400 font-bold">${escapeHtml(cleanLine)}</span>`;
      }
      // Instruction line
      return cleanLine.replace(
        /^\s*([a-zA-Z0-9_.]+)(\s*)(.*)$/,
        (_, opcode, space, operands) => {
          const coloredOpcode = `<span class="text-sky-400 font-semibold">${opcode}</span>`;
          // Color registers / symbols
          const coloredOperands = operands.replace(
            /([a-zA-Z0-9_%$]+)/g,
            (token: string) => {
              if (
                /^(a[0-7]|sp|ra|fp|gp|tp|t[0-6]|s[0-11]|zero|pc|x[0-9]+)$/.test(
                  token
                ) ||
                /^(r[0-9]+|rax|rbx|rcx|rdx|rsi|rdi|rbp|rsp|eax|ebx|ecx|edx|esi|edi)$/i.test(
                  token
                ) ||
                /^%[a-z0-9]+/i.test(token)
              ) {
                return `<span class="text-emerald-400">${token}</span>`;
              }
              if (/^0x[0-9a-fA-F]+$|^\$?[0-9]+$/.test(token)) {
                return `<span class="text-violet-300">${token}</span>`;
              }
              return token;
            }
          );
          return `        ${coloredOpcode}${space}${coloredOperands}`;
        }
      );
    }

    function isUserSourceFile(file: string | null | undefined): boolean {
      if (!file) return true;
      if (
        file.includes("/include/") ||
        file.includes("/bits/") ||
        file.includes("/opt/") ||
        file.includes("/cefs/") ||
        file.includes("/usr/")
      ) {
        return false;
      }
      return (
        file.endsWith("example.cpp") ||
        file.endsWith("example.c") ||
        file.endsWith("example.rs") ||
        file === "<stdin>" ||
        !file.startsWith("/")
      );
    }

    // Render assembly with line-by-line source mapping
    function renderAssemblyWithMapping(items: any[]) {
      sourceToAsmMap.clear();
      let html = "";
      let gutterHtml = "";
      const rawLines: string[] = [];

      items.forEach((item, idx) => {
        const lineNum = idx + 1;
        gutterHtml += `<div class="asm-gutter-item h-6 leading-6 select-none" data-asm-line="${lineNum}">${lineNum}</div>`;

        let sourceLine: number | null = null;
        if (item.source && typeof item.source.line === "number") {
          if (isUserSourceFile(item.source.file)) {
            const lineNumVal: number = item.source.line;
            sourceLine = lineNumVal;
            if (!sourceToAsmMap.has(lineNumVal)) {
              sourceToAsmMap.set(lineNumVal, []);
            }
            sourceToAsmMap.get(lineNumVal)!.push(idx);
          }
        }

        const lineText = item.text ?? "";
        rawLines.push(lineText);
        const coloredContent = highlightAssemblyLine(lineText);
        const dataAttr = sourceLine ? `data-source-line="${sourceLine}"` : "";
        const cursorClass = sourceLine ? "cursor-pointer" : "cursor-default";

        html += `<div class="asm-line-item flex items-center min-w-full h-6 leading-6 px-3.5 whitespace-pre select-text ${cursorClass} transition-colors duration-100" data-asm-index="${idx}" ${dataAttr}>${coloredContent}</div>`;
      });

      currentRawAsmText = rawLines.join("\n");
      asmOutput.innerHTML = html;
      asmGutter.innerHTML = gutterHtml;
    }

    // Clear all bidirectional highlights
    function clearAllHighlights() {
      currentHighlightedSourceLine = null;
      if (sourceActiveHighlight) {
        sourceActiveHighlight.classList.add("hidden");
        sourceActiveHighlight.style.backgroundColor = "";
        sourceActiveHighlight.style.borderLeft = "";
      }
      if (asmLinkIndicator) {
        asmLinkIndicator.classList.add("hidden");
      }
      if (root) {
        root.querySelectorAll(".is-active-line").forEach((el: any) => {
          el.classList.remove("is-active-line");
          el.style.color = "";
          el.style.fontWeight = "";
          el.style.backgroundColor = "";
        });
        root.querySelectorAll(".is-linked-asm-line").forEach((el: any) => {
          el.classList.remove("is-linked-asm-line");
          el.style.backgroundColor = "";
          el.style.borderLeft = "";
        });
      }
    }

    // Highlight source and linked assembly lines
    function highlightLinkedLines(
      sourceLine: number | null,
      triggeredBy: "source" | "asm"
    ) {
      if (sourceLine === currentHighlightedSourceLine && sourceLine !== null) {
        return;
      }
      clearAllHighlights();
      if (!sourceLine || sourceLine <= 0) return;

      currentHighlightedSourceLine = sourceLine;

      // 1. Highlight in source editor
      const totalSourceLines = sourceEditor.value.split("\n").length;
      if (sourceLine <= totalSourceLines) {
        const top =
          PADDING_TOP + (sourceLine - 1) * LINE_HEIGHT - sourceEditor.scrollTop;
        if (sourceActiveHighlight) {
          sourceActiveHighlight.style.top = `${top}px`;
          sourceActiveHighlight.style.height = `${LINE_HEIGHT}px`;
          sourceActiveHighlight.style.backgroundColor =
            "rgba(14, 165, 233, 0.22)";
          sourceActiveHighlight.style.borderLeft = "3px solid #38bdf8";
          sourceActiveHighlight.classList.remove("hidden");
        }
        const srcGutterItem = sourceGutter.querySelector(
          `[data-source-line="${sourceLine}"]`
        ) as HTMLElement;
        if (srcGutterItem) {
          srcGutterItem.classList.add("is-active-line");
          srcGutterItem.style.color = "#38bdf8";
          srcGutterItem.style.fontWeight = "700";
          srcGutterItem.style.backgroundColor = "rgba(56, 189, 248, 0.25)";
        }

        // If triggered by assembly, auto-scroll source editor if out of view
        if (triggeredBy === "asm") {
          const lineY = (sourceLine - 1) * LINE_HEIGHT;
          const viewTop = sourceEditor.scrollTop;
          const viewBottom =
            viewTop + sourceEditor.clientHeight - PADDING_TOP * 2;
          if (lineY < viewTop || lineY > viewBottom - LINE_HEIGHT) {
            sourceEditor.scrollTo({
              top: Math.max(0, lineY - LINE_HEIGHT * 3),
              behavior: "smooth",
            });
          }
        }
      }

      // 2. Highlight in assembly output
      const matchingAsmIndices = sourceToAsmMap.get(sourceLine);
      const asmCount = matchingAsmIndices ? matchingAsmIndices.length : 0;

      if (matchingAsmIndices && matchingAsmIndices.length > 0) {
        matchingAsmIndices.forEach(idx => {
          const asmItem = asmOutput.querySelector(
            `[data-asm-index="${idx}"]`
          ) as HTMLElement;
          if (asmItem) {
            asmItem.classList.add("is-linked-asm-line");
            asmItem.style.backgroundColor = "rgba(14, 165, 233, 0.32)";
            asmItem.style.borderLeft = "3px solid #38bdf8";
          }
          const asmGutterItem = asmGutter.querySelector(
            `[data-asm-line="${idx + 1}"]`
          ) as HTMLElement;
          if (asmGutterItem) {
            asmGutterItem.classList.add("is-active-line");
            asmGutterItem.style.color = "#38bdf8";
            asmGutterItem.style.fontWeight = "700";
            asmGutterItem.style.backgroundColor = "rgba(56, 189, 248, 0.25)";
          }
        });

        // If triggered by source, auto-scroll assembly view to first matching line if out of view
        if (triggeredBy === "source") {
          const firstIdx = matchingAsmIndices[0];
          const firstAsmItem = asmOutput.querySelector(
            `[data-asm-index="${firstIdx}"]`
          ) as HTMLElement;
          if (firstAsmItem) {
            const itemTop = firstAsmItem.offsetTop - PADDING_TOP;
            const viewTop = asmOutput.scrollTop;
            const viewBottom = viewTop + asmOutput.clientHeight;
            if (itemTop < viewTop || itemTop > viewBottom - LINE_HEIGHT * 2) {
              asmOutput.scrollTo({
                top: Math.max(0, itemTop - LINE_HEIGHT * 3),
                behavior: "smooth",
              });
            }
          }
        }
      }

      // 3. Update link indicator badge
      if (asmLinkIndicator && asmLinkText) {
        if (asmCount > 0) {
          asmLinkText.innerText = `源码 L${sourceLine} ↔ 汇编 ${asmCount} 条指令`;
          asmLinkIndicator.className =
            "inline-flex items-center gap-1 rounded-full border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 font-mono text-[11px] text-sky-400";
        } else {
          asmLinkText.innerText = `源码 L${sourceLine} (未生成指令 / 优化消除)`;
          asmLinkIndicator.className =
            "inline-flex items-center gap-1 rounded-full border border-outline-variant/40 bg-surface-container-high px-2 py-0.5 font-mono text-[11px] text-muted-foreground";
        }
      }
    }

    // Mouse interactions: Source Editor
    sourceEditor?.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = sourceEditor.getBoundingClientRect();
      const relativeY =
        e.clientY - rect.top + sourceEditor.scrollTop - PADDING_TOP;
      if (relativeY < 0) {
        clearAllHighlights();
        return;
      }
      const line = Math.floor(relativeY / LINE_HEIGHT) + 1;
      const totalLines = sourceEditor.value.split("\n").length;
      if (line >= 1 && line <= totalLines) {
        highlightLinkedLines(line, "source");
      } else {
        clearAllHighlights();
      }
    });

    sourceEditor?.addEventListener("mouseleave", () => {
      clearAllHighlights();
    });

    sourceEditor?.addEventListener("scroll", () => {
      if (sourceGutter) {
        sourceGutter.scrollTop = sourceEditor.scrollTop;
      }
      if (currentHighlightedSourceLine) {
        const top =
          PADDING_TOP +
          (currentHighlightedSourceLine - 1) * LINE_HEIGHT -
          sourceEditor.scrollTop;
        if (sourceActiveHighlight) {
          sourceActiveHighlight.style.top = `${top}px`;
        }
      }
    });

    // Mouse interactions: Source Gutter
    sourceGutter?.addEventListener("mouseover", (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest(
        ".source-gutter-item"
      ) as HTMLElement;
      if (!target) return;
      const lineStr = target.dataset.sourceLine;
      if (lineStr) {
        const line = parseInt(lineStr, 10);
        if (!isNaN(line) && line > 0) {
          highlightLinkedLines(line, "source");
        }
      }
    });

    sourceGutter?.addEventListener("mouseleave", () => {
      clearAllHighlights();
    });

    // Mouse interactions: Assembly Output
    asmOutput?.addEventListener("mouseover", (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest(
        ".asm-line-item"
      ) as HTMLElement;
      if (!target) return;
      const srcLineStr = target.dataset.sourceLine;
      if (srcLineStr) {
        const line = parseInt(srcLineStr, 10);
        if (!isNaN(line) && line > 0) {
          highlightLinkedLines(line, "asm");
          return;
        }
      }
      // If no source mapping, clear link highlights and highlight this solo asm line
      clearAllHighlights();
      target.classList.add("is-linked-asm-line");
      target.style.backgroundColor = "rgba(14, 165, 233, 0.25)";
      target.style.borderLeft = "3px solid #38bdf8";
    });

    asmOutput?.addEventListener("mouseleave", () => {
      clearAllHighlights();
    });

    asmOutput?.addEventListener("scroll", () => {
      if (asmGutter) {
        asmGutter.scrollTop = asmOutput.scrollTop;
      }
    });

    // Per-(lang, target) Argument Stores
    let currentLang = langSelect?.value || "cpp";
    let currentAsmTarget = asmCompilerSelect?.value || "rv64-gcc1420";
    const asmArgsByKey: Record<string, string> = {};
    const execArgsByLang: Record<string, string> = {};

    function getDefaultAsmArgs(lang: string, target: string): string {
      return (
        ASM_DEFAULT_ARGS[lang]?.[target] ??
        ASM_DEFAULT_ARGS[lang]?.g142 ??
        "-O2"
      );
    }

    function getDefaultExecArgs(lang: string): string {
      return EXEC_DEFAULT_ARGS[lang] ?? "-O2";
    }

    function updateFlagPillsActiveState(
      container: HTMLElement | null,
      inputEl: HTMLInputElement | null,
      accent: "sky" | "emerald"
    ) {
      if (!container || !inputEl) return;
      const tokens = inputEl.value.trim().split(/\s+/).filter(Boolean);
      const activeCls =
        accent === "sky"
          ? [
              "border-sky-500/50",
              "bg-sky-500/15",
              "text-sky-700",
              "dark:text-sky-300",
            ]
          : [
              "border-emerald-500/50",
              "bg-emerald-500/15",
              "text-emerald-700",
              "dark:text-emerald-300",
            ];
      const inactiveCls = [
        "border-outline-variant/40",
        "bg-surface-container-high/80",
        "text-on-surface-variant",
      ];

      container
        .querySelectorAll<HTMLButtonElement>(".flag-pill")
        .forEach(btn => {
          const flag = btn.dataset.flag || "";
          const isActive = tokens.includes(flag);
          btn.classList.remove(...activeCls, ...inactiveCls);
          btn.classList.add(...(isActive ? activeCls : inactiveCls));
          btn.setAttribute("aria-pressed", String(isActive));
        });
    }

    function toggleCompilerFlag(
      inputEl: HTMLInputElement,
      pill: FlagPill,
      lang: string
    ) {
      let tokens = inputEl.value.trim().split(/\s+/).filter(Boolean);
      const exists = tokens.includes(pill.flag);

      if (pill.group === "opt") {
        const optRegex =
          lang === "rust" ? /^(-Copt-level=[0-3sz]|-O)$/ : /^-O[0-3sfastg]?$/;
        const idx = tokens.findIndex(t => optRegex.test(t));
        if (idx !== -1) {
          tokens = tokens.filter((t, i) => !optRegex.test(t) || i === idx);
          tokens[tokens.findIndex(t => optRegex.test(t))] = pill.flag;
        } else {
          tokens.unshift(pill.flag);
        }
      } else if (pill.group === "march") {
        if (exists) {
          tokens = tokens.filter(t => t !== pill.flag);
        } else {
          tokens = tokens.filter(t => !t.startsWith("-march="));
          tokens.push(pill.flag);
        }
      } else if (pill.group === "mcpu") {
        if (exists) {
          tokens = tokens.filter(t => t !== pill.flag);
        } else {
          tokens = tokens.filter(t => !t.startsWith("-mcpu="));
          tokens.push(pill.flag);
        }
      } else if (pill.group === "target") {
        if (exists) {
          tokens = tokens.filter(t => t !== pill.flag);
        } else {
          tokens = tokens.filter(t => !t.startsWith("--target="));
          tokens.push(pill.flag);
        }
      } else {
        if (exists) {
          tokens = tokens.filter(t => t !== pill.flag);
        } else {
          tokens.push(pill.flag);
        }
      }

      inputEl.value = tokens.join(" ");
    }

    function renderFlagPills(
      container: HTMLElement | null,
      inputEl: HTMLInputElement | null,
      pills: FlagPill[],
      accent: "sky" | "emerald",
      onAfterToggle: () => void
    ) {
      if (!container || !inputEl) return;
      container.innerHTML = "";
      pills.forEach(pill => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "flag-pill cursor-pointer rounded-md border px-1.5 py-0.5 font-mono text-[10px] font-medium transition-colors hover:opacity-90 active:scale-95";
        btn.dataset.flag = pill.flag;
        btn.title = pill.title;
        btn.textContent = pill.label || pill.flag;
        btn.addEventListener("click", () => {
          toggleCompilerFlag(inputEl, pill, langSelect?.value || "cpp");
          updateFlagPillsActiveState(container, inputEl, accent);
          onAfterToggle();
        });
        container.appendChild(btn);
      });
      updateFlagPillsActiveState(container, inputEl, accent);
    }

    function syncAsmCompilerOptions(lang: string) {
      if (!asmCompilerSelect) return;
      const isRust = lang === "rust";
      const labelMap: Record<string, string> = isRust
        ? {
            "rv64-gcc1420": "RISC-V 64 (rustc 1.83)",
            g142: "x86-64 (rustc 1.83)",
            clang1910: "x86-64 Clang (不支持 Rust)",
            "aarch64-gcc1420": "ARM64 (rustc 1.83)",
          }
        : {
            "rv64-gcc1420": "RISC-V 64 (GCC 14.2)",
            g142: "x86-64 (GCC 14.2)",
            clang1910: "x86-64 (Clang 19.1)",
            "aarch64-gcc1420": "ARM64 (GCC 14.2)",
          };

      Array.from(asmCompilerSelect.options).forEach(opt => {
        if (labelMap[opt.value]) opt.text = labelMap[opt.value];
        if (opt.value === "clang1910") {
          opt.disabled = isRust;
          opt.hidden = isRust;
        }
      });

      if (isRust && asmCompilerSelect.value === "clang1910") {
        asmCompilerSelect.value = "g142";
        currentAsmTarget = "g142";
      }
    }

    function syncExecEngineLabel(lang: string) {
      if (!execEngineInfo) return;
      const label =
        lang === "rust"
          ? "云端沙箱 (amd64 · rustc 1.83)"
          : "云端沙箱 (amd64 · GCC 14.2)";
      execEngineInfo.innerText = label;
    }

    function refreshAllFlagPills() {
      const lang = langSelect?.value || "cpp";
      const asmTarget = asmCompilerSelect?.value || "rv64-gcc1420";
      renderFlagPills(
        asmFlagPills,
        asmArgsInput,
        getAsmPills(lang, asmTarget),
        "sky",
        () => {
          asmArgsByKey[`${lang}:${asmTarget}`] = asmArgsInput.value;
          if (sourceEditor?.value.trim()) {
            compileAssembly();
          }
        }
      );
      renderFlagPills(
        execFlagPills,
        execArgsInput,
        EXEC_PILLS[lang] || EXEC_PILLS.cpp,
        "emerald",
        () => {
          execArgsByLang[lang] = execArgsInput.value;
        }
      );
    }

    asmArgsInput?.addEventListener("input", () => {
      asmArgsByKey[`${currentLang}:${currentAsmTarget}`] = asmArgsInput.value;
      updateFlagPillsActiveState(asmFlagPills, asmArgsInput, "sky");
    });

    asmArgsInput?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        e.preventDefault();
        compileAssembly();
      }
    });

    execArgsInput?.addEventListener("input", () => {
      execArgsByLang[currentLang] = execArgsInput.value;
      updateFlagPillsActiveState(execFlagPills, execArgsInput, "emerald");
    });

    execArgsInput?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        e.preventDefault();
        runExecution();
      }
    });

    btnAsmArgsReset?.addEventListener("click", () => {
      const def = getDefaultAsmArgs(currentLang, currentAsmTarget);
      asmArgsInput.value = def;
      asmArgsByKey[`${currentLang}:${currentAsmTarget}`] = def;
      updateFlagPillsActiveState(asmFlagPills, asmArgsInput, "sky");
      showToast("已重置当前架构汇编参数");
      if (sourceEditor?.value.trim()) {
        compileAssembly();
      }
    });

    btnExecArgsReset?.addEventListener("click", () => {
      const def = getDefaultExecArgs(currentLang);
      execArgsInput.value = def;
      execArgsByLang[currentLang] = def;
      updateFlagPillsActiveState(execFlagPills, execArgsInput, "emerald");
      showToast("已重置当前语言运行参数");
    });

    langSelect?.addEventListener("change", () => {
      // Persist previous language args
      if (asmArgsInput) {
        asmArgsByKey[`${currentLang}:${currentAsmTarget}`] = asmArgsInput.value;
      }
      if (execArgsInput) {
        execArgsByLang[currentLang] = execArgsInput.value;
      }

      const lang = langSelect.value;
      currentLang = lang;
      if (sourceBadge) {
        sourceBadge.innerText = LANG_BADGE_MAP[lang] || lang.toUpperCase();
      }
      syncAsmCompilerOptions(lang);
      currentAsmTarget = asmCompilerSelect?.value || "rv64-gcc1420";
      syncExecEngineLabel(lang);

      if (asmArgsInput) {
        asmArgsInput.value =
          asmArgsByKey[`${lang}:${currentAsmTarget}`] ??
          getDefaultAsmArgs(lang, currentAsmTarget);
      }
      if (execArgsInput) {
        execArgsInput.value = execArgsByLang[lang] ?? getDefaultExecArgs(lang);
      }
      refreshAllFlagPills();
    });

    // Source Buttons
    btnSourceClear?.addEventListener("click", () => {
      if (sourceEditor) {
        sourceEditor.value = "";
        clearAllHighlights();
        updateSourceGutter();
      }
    });

    btnSourceCopy?.addEventListener("click", async () => {
      if (sourceEditor?.value) {
        await navigator.clipboard.writeText(sourceEditor.value);
        showToast("源码已复制到剪贴板");
      }
    });

    btnAsmCopy?.addEventListener("click", async () => {
      const text = currentRawAsmText || asmOutput?.innerText || "";
      if (text) {
        await navigator.clipboard.writeText(text);
        showToast("汇编指令已复制到剪贴板");
      }
    });

    btnExecClear?.addEventListener("click", () => {
      if (terminalOutput) {
        terminalOutput.innerHTML = `<span class="text-muted-foreground/60">$ 控制台已清空。</span>\n`;
      }
    });

    btnToggleStdin?.addEventListener("click", () => {
      stdinPanel.classList.toggle("hidden");
    });

    // Fullscreen Toggle
    btnFullscreen?.addEventListener("click", () => {
      root.classList.toggle("compiler-fullscreen");
      iconFsEnter.classList.toggle("hidden");
      iconFsExit.classList.toggle("hidden");
      if (root.classList.contains("compiler-fullscreen")) {
        document.body.style.overflow = "hidden";
      } else {
        document.body.style.overflow = "";
      }
    });

    // Share / Copy Link
    btnShare?.addEventListener("click", async () => {
      const state = {
        code: sourceEditor.value,
        lang: langSelect.value,
        asmComp: asmCompilerSelect.value,
        asmArgs: asmArgsInput.value,
        execArgs: execArgsInput.value,
      };
      try {
        const hash = encodeURIComponent(JSON.stringify(state));
        window.location.hash = `state=${hash}`;
        await navigator.clipboard.writeText(window.location.href);
        showToast("分享链接已复制到剪贴板！");
      } catch {
        showToast("生成分享链接失败");
      }
    });

    // Mobile View Switcher
    root
      .querySelectorAll<HTMLButtonElement>(".mobile-view-btn")
      .forEach(btn => {
        btn.addEventListener("click", () => {
          const targetView = btn.dataset.mobileView;
          root.querySelectorAll(".mobile-view-btn").forEach(b => {
            b.classList.remove(
              "bg-secondary-container",
              "text-on-secondary-container",
              "shadow-xs"
            );
            b.classList.add("text-on-surface-variant");
          });
          btn.classList.add(
            "bg-secondary-container",
            "text-on-secondary-container",
            "shadow-xs"
          );
          btn.classList.remove("text-on-surface-variant");

          const colSource = document.getElementById("col-source");
          const colAsm = document.getElementById("col-asm");
          const colExec = document.getElementById("col-exec");

          if (colSource && colAsm && colExec) {
            if (targetView === "source") {
              colSource.classList.remove("hidden");
              colAsm.classList.add("hidden");
              colExec.classList.add("hidden");
            } else if (targetView === "asm") {
              colSource.classList.add("hidden");
              colAsm.classList.remove("hidden");
              colExec.classList.add("hidden");
            } else if (targetView === "exec") {
              colSource.classList.add("hidden");
              colAsm.classList.add("hidden");
              colExec.classList.remove("hidden");
            }
          }
        });
      });

    // 1. Generate Assembly Logic
    async function compileAssembly() {
      if (isCompilingAsm) return;
      const code = sourceEditor.value.trim();
      if (!code) {
        showToast("请输入源码后再生成汇编！");
        return;
      }

      isCompilingAsm = true;
      clearAllHighlights();

      const lang = langSelect.value;
      const userArguments = asmArgsInput.value.trim();
      const asmTarget = asmCompilerSelect.value;
      const actualAsmCompiler = COMPILER_MAP[lang]?.[asmTarget] || asmTarget;

      // UI state -> compiling assembly
      btnAsm.disabled = true;
      asmBtnIcon.classList.add("hidden");
      asmSpinIcon.classList.remove("hidden");
      asmTime.innerText = "耗时: 编译中...";
      asmOutput.innerHTML = `<div class="px-3.5 leading-6 text-amber-400/90">; 正在生成目标汇编 (${actualAsmCompiler})...</div>`;

      const startTime = performance.now();

      const asmPayload = {
        source: code,
        compiler: actualAsmCompiler,
        options: {
          userArguments,
          filters: {
            binary: false,
            execute: false,
            demangle: filterDemangle.checked,
            directives: filterDirectives.checked,
            comments: filterComments.checked,
            labels: true,
            trim: true,
          },
          tools: [],
          libraries: [],
        },
        lang: lang === "c" ? "c" : lang === "rust" ? "rust" : "c++",
        bypassCache: 0,
      };

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 25000);

      try {
        const res = await fetch(
          `${CE_BASE_URL}/api/compiler/${actualAsmCompiler}/compile`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(asmPayload),
            signal: controller.signal,
          }
        );

        clearTimeout(timeoutId);
        const totalDuration = Math.round(performance.now() - startTime);

        if (res.ok) {
          const asmData = await res.json();
          if (
            asmData.code !== 0 &&
            (!asmData.asm || asmData.asm.length === 0)
          ) {
            const asmErr = formatLines(
              asmData.buildResult?.stderr || asmData.stderr
            );
            asmOutput.innerHTML = `<div class="px-3.5 leading-6 text-rose-400">; 汇编生成失败 (Code ${asmData.code}):\n${escapeHtml(asmErr)}</div>`;
            asmStats.innerText = "编译错误";
            asmTime.innerText = `耗时: ${asmData.execTime ?? totalDuration}ms`;
            let gutterHtml = "";
            const errLines = asmErr.split("\n").length;
            for (let i = 1; i <= errLines; i++) {
              gutterHtml += `<div class="asm-gutter-item h-6 leading-6 select-none">${i}</div>`;
            }
            asmGutter.innerHTML = gutterHtml;
          } else {
            if (Array.isArray(asmData.asm) && asmData.asm.length > 0) {
              renderAssemblyWithMapping(asmData.asm);
              const lineCount = asmData.asm.length;
              asmStats.innerText = `${lineCount} 行指令`;
              asmTime.innerText = `耗时: ${asmData.execTime ?? totalDuration}ms`;
            } else {
              asmOutput.innerHTML = `<div class="px-3.5 leading-6 text-slate-500">; [未生成汇编代码或优化完全消除]</div>`;
              asmStats.innerText = "0 行指令";
              asmTime.innerText = `耗时: ${totalDuration}ms`;
              asmGutter.innerHTML = `<div class="asm-gutter-item h-6 leading-6 select-none">1</div>`;
            }
          }
        } else {
          asmOutput.innerHTML = `<div class="px-3.5 leading-6 text-rose-400">; 汇编服务请求失败: HTTP ${res.status}</div>`;
          asmStats.innerText = "请求失败";
        }
      } catch (err: any) {
        clearTimeout(timeoutId);
        asmOutput.innerHTML = `<div class="px-3.5 leading-6 text-rose-400">; 汇编生成异常: ${escapeHtml(err?.message || String(err))}</div>`;
        asmStats.innerText = "异常";
      } finally {
        isCompilingAsm = false;
        btnAsm.disabled = false;
        asmBtnIcon.classList.remove("hidden");
        asmSpinIcon.classList.add("hidden");
      }
    }

    // 2. Run Execution Sandbox Logic
    async function runExecution() {
      if (isRunningExec) return;
      const code = sourceEditor.value.trim();
      if (!code) {
        showToast("请输入源码后再运行！");
        return;
      }

      isRunningExec = true;

      const lang = langSelect.value;
      const userArguments = execArgsInput.value.trim();
      const actualExecCompiler = EXEC_COMPILER_MAP[lang] || "g142";

      // UI state -> running
      btnRun.disabled = true;
      runPlayIcon.classList.add("hidden");
      runSpinIcon.classList.remove("hidden");

      execStatusDot.className =
        "size-1.5 rounded-full bg-amber-500 animate-pulse";
      execStatusText.innerText = "编译运行中...";
      execDuration.innerText = "耗时: 运行中...";

      terminalOutput.innerHTML = `<span class="text-amber-400/90">$ [Compiler Explorer] 正在提交运行请求...</span>\n`;

      const startTime = performance.now();

      const execPayload = {
        source: code,
        compiler: actualExecCompiler,
        options: {
          userArguments,
          executeParameters: {
            args: [],
            stdin: stdinInput?.value || "",
          },
          compilerOptions: {
            executorRequest: true,
          },
          filters: {
            execute: true,
          },
          tools: [],
          libraries: [],
        },
        lang: lang === "c" ? "c" : lang === "rust" ? "rust" : "c++",
        bypassCache: 0,
      };

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 25000);

      try {
        const res = await fetch(
          `${CE_BASE_URL}/api/compiler/${actualExecCompiler}/compile`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(execPayload),
            signal: controller.signal,
          }
        );

        clearTimeout(timeoutId);
        const totalDuration = Math.round(performance.now() - startTime);

        if (res.ok) {
          const execData = await res.json();
          let outHtml = "";

          // Check Build Failure
          const buildResult = execData.buildResult;
          const buildCode = buildResult
            ? buildResult.code
            : execData.didExecute
              ? 0
              : execData.code;

          if (buildCode !== 0) {
            const buildErr = formatLines(
              buildResult?.stderr || execData.stderr
            );
            const buildOut = formatLines(buildResult?.stdout);
            execStatusDot.className = "size-1.5 rounded-full bg-rose-500";
            execStatusText.innerText = `编译错误 (${buildCode})`;

            outHtml += `<span class="text-rose-400 font-bold">[编译构建失败 (Exit Code: ${buildCode})]</span>\n`;
            if (buildErr)
              outHtml += `<span class="text-rose-400">${escapeHtml(buildErr)}</span>\n`;
            if (buildOut)
              outHtml += `<span class="text-[#c9d1d9]">${escapeHtml(buildOut)}</span>\n`;

            if (
              buildErr.includes("undefined reference to `main'") ||
              buildErr.includes("undefined reference to 'main'")
            ) {
              outHtml += `\n<span class="text-amber-400/90">[提示] 代码中未检测到 main() 入口函数。如需独立运行请补充 main()，或在中间栏查看生成的汇编代码。</span>\n`;
            }
          } else {
            // Build Succeeded, Process Execution
            if (buildResult?.stderr?.length) {
              const warnings = formatLines(buildResult.stderr);
              if (warnings.trim()) {
                outHtml += `<span class="text-amber-400/80">[编译告警]\n${escapeHtml(warnings)}</span>\n\n`;
              }
            }

            if (execData.didExecute) {
              const execStdout = formatLines(execData.stdout);
              const execStderr = formatLines(execData.stderr);

              if (execStdout)
                outHtml += `<span class="text-[#e6edf3]">${escapeHtml(execStdout)}</span>\n`;
              if (execStderr)
                outHtml += `<span class="text-rose-400 font-semibold">${escapeHtml(execStderr)}</span>\n`;

              if (execData.timedOut) {
                outHtml += `\n<span class="text-rose-400 font-bold">[执行超时] 程序超出沙箱时间上限。</span>\n`;
              }

              if (execData.code !== 0) {
                execStatusDot.className = "size-1.5 rounded-full bg-rose-500";
                execStatusText.innerText = `异常退出 (${execData.code})`;
                outHtml += `\n<span class="text-rose-400">[程序异常退出，退出码: ${execData.code}]</span>\n`;
              } else {
                execStatusDot.className =
                  "size-1.5 rounded-full bg-emerald-500";
                execStatusText.innerText = "成功 (Exit 0)";
                if (!execStdout && !execStderr) {
                  outHtml += `<span class="text-emerald-400/80">[程序执行成功，无标准输出 (Exit 0)]</span>\n`;
                }
              }
            } else {
              execStatusDot.className = "size-1.5 rounded-full bg-emerald-500";
              execStatusText.innerText = "构建完成";
              outHtml += `<span class="text-emerald-400/80">[程序编译构建成功]</span>\n`;
            }
          }

          terminalOutput.innerHTML = outHtml;
          execDuration.innerText = `耗时: ${execData.execTime ?? totalDuration}ms`;
          execEngineInfo.innerText = `云端沙箱 (${actualExecCompiler.toUpperCase()} / amd64)`;
        } else {
          execStatusDot.className = "size-1.5 rounded-full bg-rose-500";
          execStatusText.innerText = "网络异常";
          terminalOutput.innerHTML = `<span class="text-rose-400">[网络或服务异常] 请求沙箱失败: HTTP ${res.status}</span>\n`;
        }

        terminalContainer.scrollTo({
          top: terminalContainer.scrollHeight,
          behavior: "smooth",
        });
      } catch (err: any) {
        clearTimeout(timeoutId);
        execStatusDot.className = "size-1.5 rounded-full bg-rose-500";
        execStatusText.innerText = "异常";
        terminalOutput.innerHTML = `<span class="text-rose-400">[未捕获异常]: ${escapeHtml(err?.message || String(err))}</span>\n`;
      } finally {
        isRunningExec = false;
        btnRun.disabled = false;
        runPlayIcon.classList.remove("hidden");
        runSpinIcon.classList.add("hidden");
      }
    }

    btnAsm?.addEventListener("click", compileAssembly);
    btnRun?.addEventListener("click", runExecution);

    // Assembly compiler / architecture change -> switch arch-specific args & recompile asm
    asmCompilerSelect?.addEventListener("change", () => {
      if (asmArgsInput) {
        asmArgsByKey[`${currentLang}:${currentAsmTarget}`] = asmArgsInput.value;
      }
      currentAsmTarget = asmCompilerSelect.value;
      if (asmArgsInput) {
        asmArgsInput.value =
          asmArgsByKey[`${currentLang}:${currentAsmTarget}`] ??
          getDefaultAsmArgs(currentLang, currentAsmTarget);
      }
      refreshAllFlagPills();
      if (sourceEditor?.value.trim()) {
        compileAssembly();
      }
    });

    [filterDirectives, filterComments, filterDemangle].forEach(checkbox => {
      checkbox?.addEventListener("change", () => {
        if (sourceEditor?.value.trim()) {
          compileAssembly();
        }
      });
    });

    // Restore state from hash if present
    if (window.location.hash.startsWith("#state=")) {
      try {
        const rawJson = decodeURIComponent(
          window.location.hash.replace("#state=", "")
        );
        const state = JSON.parse(rawJson);
        if (state.code) sourceEditor.value = state.code;
        if (state.lang) {
          langSelect.value = state.lang;
          currentLang = state.lang;
        }
        syncAsmCompilerOptions(currentLang);
        if (state.asmComp) {
          asmCompilerSelect.value = state.asmComp;
          currentAsmTarget = state.asmComp;
        }
        syncExecEngineLabel(currentLang);
        const restoredAsmArgs =
          state.asmArgs ??
          state.args ??
          getDefaultAsmArgs(currentLang, currentAsmTarget);
        const restoredExecArgs =
          state.execArgs ?? state.args ?? getDefaultExecArgs(currentLang);
        asmArgsInput.value = restoredAsmArgs;
        execArgsInput.value = restoredExecArgs;
        asmArgsByKey[`${currentLang}:${currentAsmTarget}`] = restoredAsmArgs;
        execArgsByLang[currentLang] = restoredExecArgs;
        if (sourceBadge) {
          sourceBadge.innerText =
            LANG_BADGE_MAP[currentLang] || currentLang.toUpperCase();
        }
        refreshAllFlagPills();
        clearAllHighlights();
        updateSourceGutter();
        if (state.code) {
          compileAssembly();
          runExecution();
        }
      } catch {
        sourceEditor.value = "";
        syncAsmCompilerOptions(currentLang);
        syncExecEngineLabel(currentLang);
        asmArgsInput.value = getDefaultAsmArgs(currentLang, currentAsmTarget);
        execArgsInput.value = getDefaultExecArgs(currentLang);
        refreshAllFlagPills();
        clearAllHighlights();
        updateSourceGutter();
      }
    } else {
      sourceEditor.value = "";
      syncAsmCompilerOptions(currentLang);
      syncExecEngineLabel(currentLang);
      asmArgsInput.value = getDefaultAsmArgs(currentLang, currentAsmTarget);
      execArgsInput.value = getDefaultExecArgs(currentLang);
      refreshAllFlagPills();
      clearAllHighlights();
      updateSourceGutter();
    }
  }

  // Support Astro View Transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCompilerWorkspace);
  } else {
    initCompilerWorkspace();
  }
  document.addEventListener("astro:page-load", initCompilerWorkspace);
</script>

