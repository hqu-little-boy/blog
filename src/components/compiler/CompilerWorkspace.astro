    color: #ffffff !important;
  }

  :global(.asm-gutter-item) {
    box-sizing: border-box !important;
    transition:
      color 0.1s ease,
      background-color 0.1s ease;
  }

  :global(.asm-gutter-item.is-active-line) {
    color: #38bdf8 !important;
