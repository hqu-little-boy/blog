---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group inline-flex items-center rounded-full border border-border/80 bg-muted/70 text-muted-foreground hover:border-accent/40 hover:bg-accent/15 hover:text-accent transition-all duration-200 shadow-xs active:scale-95",
      {
        "px-2.5 py-0.5 text-xs font-medium gap-1": size === "sm",
        "px-3.5 py-1 text-sm font-medium gap-1.5": size === "lg",
      },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-60 transition-opacity group-hover:opacity-100",
        { "size-3.5": size === "sm" },
        { "size-4": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>

