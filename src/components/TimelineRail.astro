---
import type { TimePeriod } from "@/utils/getTimePeriods";

type Props = {
  periods: TimePeriod[];
};

const { periods } = Astro.props;
---

{
  periods.length > 0 && (
    <aside
      aria-label="快速时间导航"
      class="hidden lg:block timeline-desktop-rail select-none pointer-events-auto"
    >
      <!-- 极简风格：纯净的竖线与穿插其间的圆点，无卡片框与厚重背景 -->
      <nav class="relative py-2 ps-1">
        <!-- 垂直贯穿细线（上下渐隐淡出，极致极简） -->
        <div
          aria-hidden="true"
          class="timeline-track-line absolute left-[6px] top-1 bottom-1 w-[1.5px] bg-gradient-to-b from-transparent via-border to-transparent dark:via-border/60"
        />

        <ul class="relative space-y-6">
          {periods.map(period => (
            <li>
              <a
                href={`#${period.id}`}
                data-timeline-target={period.id}
                class="timeline-node-link group flex items-center gap-3 py-1 outline-none transition-all duration-200"
                title={`跳转到 ${period.label} (${period.count} 篇)`}
              >
                <!-- 串在竖线上的小圆点 -->
                <span class="timeline-dot relative z-10 flex size-3.5 items-center justify-center rounded-full border-2 border-border/80 bg-background dark:bg-background transition-all duration-300 group-hover:scale-125 group-hover:border-accent">
                  <span class="timeline-dot-inner size-1 rounded-full bg-border/80 transition-all duration-300 group-hover:bg-accent" />
                </span>

                <!-- 极简时间段标签 -->
                <span class="timeline-label flex items-baseline gap-1.5 text-xs font-mono text-muted-foreground/75 transition-all duration-300 group-hover:text-foreground">
                  <span class="font-medium tracking-tight">
                    {period.label}
                  </span>
                  <span class="text-[10px] opacity-60">
                    ({period.count})
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  let removeScrollListener: (() => void) | null = null;

  function initTimelineScrollSpy() {
    if (removeScrollListener) {
      removeScrollListener();
      removeScrollListener = null;
    }

    const jumpLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        ".timeline-node-link, a[href^='#date-'], a[href^='#month-'], a[href^='#year-']"
      )
    );

    // 平滑点击跳转
    jumpLinks.forEach(link => {
      link.addEventListener("click", e => {
        const href = link.getAttribute("href") || "";
        const targetId =
          link.getAttribute("data-timeline-target") ||
          (href.startsWith("#") ? href.slice(1) : "");
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", `#${targetId}`);
        }
      });
    });

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".timeline-node-link")
    );
    if (!links.length) return;

    const sections = links
      .map(link => {
        const id = link.getAttribute("data-timeline-target");
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    let ticking = false;

    function updateActiveNode() {
      const threshold = 180;
      let currentActiveId: string | null = null;

      for (let i = 0; i < sections.length; i++) {
        const rect = sections[i].getBoundingClientRect();
        if (rect.top <= threshold) {
          currentActiveId = sections[i].id;
        } else {
          break;
        }
      }

      if (!currentActiveId && sections.length > 0) {
        currentActiveId = sections[0].id;
      }

      links.forEach(link => {
        const id = link.getAttribute("data-timeline-target");
        const dot = link.querySelector(".timeline-dot");
        const innerDot = link.querySelector(".timeline-dot-inner");
        const label = link.querySelector(".timeline-label");
        const isActive = id === currentActiveId;

        if (isActive) {
          link.classList.add("is-active");
          dot?.classList.add(
            "!border-accent",
            "!bg-accent",
            "scale-125",
            "ring-4",
            "ring-accent/20",
            "shadow-xs"
          );
          innerDot?.classList.add("!bg-background");
          label?.classList.add("!text-accent", "!font-semibold");
        } else {
          link.classList.remove("is-active");
          dot?.classList.remove(
            "!border-accent",
            "!bg-accent",
            "scale-125",
            "ring-4",
            "ring-accent/20",
            "shadow-xs"
          );
          innerDot?.classList.remove("!bg-background");
          label?.classList.remove("!text-accent", "!font-semibold");
        }
      });
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActiveNode();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    updateActiveNode();

    removeScrollListener = () => {
      window.removeEventListener("scroll", onScroll);
    };
  }

  document.addEventListener("astro:page-load", initTimelineScrollSpy);
</script>
